---
export const prerender = false;
import Layout from "../components/Layout.astro";
import { copy } from "../copy.js";
import "../styles.css";

function maskedRoute(url) {
  const clone = new URL(url);
  for (const key of ["code", "SESSION_TOKEN"]) {
    if (clone.searchParams.has(key)) clone.searchParams.set(key, "[masked]");
  }
  if (clone.hash) {
    const params = new URLSearchParams(clone.hash.slice(1));
    if (params.has("id_token")) params.set("id_token", "[masked]");
    clone.hash = params.toString();
  }
  return `${clone.pathname}${clone.search}${clone.hash}`;
}
---

<Layout title="Astro OAuth Smoke">
  <main class="shell">
    <nav class="nav" aria-label="Astro smoke routes">
      <a id="route-home" href="/">Home</a>
      <a id="route-account" href="/accounts/%E6%9D%B1%E4%BA%AC?tab=r%C3%A9sum%C3%A9#über">Account</a>
      <a id="route-slow" href="/slow?locale=fr-CA#deep-target">Slow</a>
      <a id="route-oauth" href="http://localhost:8149/oauth/start">OAuth</a>
    </nav>

    <section class="panel hero">
      <h1 id="astro-heading">{copy.heading}</h1>
      <p id="astro-callback-route">Route: {maskedRoute(Astro.url)}</p>
      <button id="astro-oauth-action" type="button">{copy.oauth}</button>
    </section>
  </main>
</Layout>
