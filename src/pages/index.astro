---
import Layout from "../components/Layout.astro";
import SlotShell from "../components/SlotShell.astro";
import { IslandPanel } from "../components/IslandPanel.jsx";
import { copy } from "../copy.js";
import "../styles.css";

const backendUrl = "http://localhost:8149";
const generatedHtml = `<button id="astro-generated-action" type="button" data-testid="astro:generated/[button]">${copy.generatedAction}</button>`;
---

<Layout title="Astro Island Smoke">
  <main class="shell">
    <nav class="nav" aria-label="Astro smoke routes">
      <a id="route-home" href="/">Home</a>
      <a id="route-account" href="/accounts/%E6%9D%B1%E4%BA%AC?tab=r%C3%A9sum%C3%A9#über">Account</a>
      <a id="route-slow" href="/slow?locale=fr-CA#deep-target">Slow</a>
      <a id="route-oauth" href={`${backendUrl}/oauth/start`}>OAuth</a>
    </nav>

    <section class="panel hero">
      <h1 id="astro-heading">{copy.heading}</h1>
      <p id="astro-route">/</p>
      <button id="astro-static-action" type="button">{copy.staticAction}</button>
      <span set:html={generatedHtml} />
    </section>

    <SlotShell title="Astro slotted surface">
      <button slot="toolbar" id="astro-slotted-action" type="button">Astro slotted action</button>
      <p>Astro static and island content share the preview.</p>
    </SlotShell>

    <IslandPanel client:load backendUrl={backendUrl} copy={copy} />
  </main>
</Layout>
